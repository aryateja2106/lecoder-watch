 import time
 from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
 from urllib.parse import urlparse
@@ -47,6 +48,30 @@ def _split_think(text: str, think: bool):
     return "", text
 
 
+
+_TOOL_CALL = re.compile(r"<tool_call>\s*([^\s<]+)(.*?)</tool_call>", re.S)
+_TOOL_ARG = re.compile(r"<arg_key>(.*?)</arg_key>\s*<arg_value>(.*?)</arg_value>", re.S)
+
+
+def _extract_tool_calls(content: str):
+    """Turn the template's <tool_call>name<arg_key>k</arg_key><arg_value>v</arg_value></tool_call>
+    blocks into OpenAI ``tool_calls`` entries; the remaining text stays as content."""
+    calls = []
+    for i, m in enumerate(_TOOL_CALL.finditer(content or "")):
+        name, body = m.group(1).strip(), m.group(2)
+        args = {}
+        for k, v in _TOOL_ARG.findall(body):
+            v = v.strip()
+            try:
+                args[k.strip()] = json.loads(v)
+            except Exception:  # noqa: BLE001 — bare strings are the common case
+                args[k.strip()] = v
+        calls.append({"id": f"call_{int(time.time() * 1000)}_{i}", "type": "function",
+                      "function": {"name": name, "arguments": json.dumps(args)}})
+    rest = _TOOL_CALL.sub("", content or "").strip() if calls else content
+    return calls, rest
+
+
