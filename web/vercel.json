{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/install.sh",
      "destination": "https://github.com/LeSearch-AI/mesh-install/releases/latest/download/install.sh",
      "permanent": false
    },
    { "source": "/beta",   "destination": "https://testflight.apple.com/join/pVYPTxc7", "permanent": false },
    { "source": "/github", "destination": "https://github.com/LeSearch-AI/mesh-install", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
