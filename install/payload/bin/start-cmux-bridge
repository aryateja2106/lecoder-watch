#!/bin/zsh
# Re-exec in the current interactive shell so launchctl asuser inherits the GUI session.
if [[ ! -o interactive ]]; then
  echo "Open Terminal.app and run: source ~/.mesh/hooks/cmux-bridge.zsh && start_cmux_bridge" >&2
  exit 1
fi
source "$HOME/.mesh/hooks/cmux-bridge.zsh"
start_cmux_bridge
