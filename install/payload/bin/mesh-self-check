#!/bin/sh

set -u

HOST="${MESHD_HOST:-127.0.0.1}"
PORT="${MESHD_PORT:-8899}"
BRIDGE_HOST="${BRIDGE_HOST:-127.0.0.1}"
BRIDGE_PORT="${BRIDGE_PORT:-7820}"
VNC_URL="${MESH_VNC_URL:-http://127.0.0.1:6080/vnc.html}"
TOKEN="${MESHD_TOKEN:-}"
TOKEN_FILE="${MESH_HOME:-$HOME/.mesh}/token"

if [ -z "$TOKEN" ] && [ -r "$TOKEN_FILE" ]; then
  TOKEN=$(sed -n '1p' "$TOKEN_FILE")
fi

# Never build curl arguments in a string. `auth="-H Authorization: Bearer $TOKEN"` used
# unquoted split into FOUR words under /bin/sh: `-H`, `Authorization:` (an empty header,
# which deletes it), and then `Bearer` and the token itself — both of which curl treated as
# URLs and reported by name. So no probe was ever authenticated, and the machine's bearer
# token was written verbatim into a world-readable file in /tmp and printed to the terminal.
# Reproduced: `curl: (6) Could not resolve host: <the real token>`.
# A wrapper passes the header as one argument and cannot be split, whatever the token holds.
mcurl() {
  if [ -n "$TOKEN" ]; then
    curl -H "Authorization: Bearer $TOKEN" "$@"
  else
    curl "$@"
  fi
}

http_code() {
  mcurl -s -o /dev/null -w '%{http_code}' "$1"
}

printf 'meshd: '
health_err=$(mktemp "${TMPDIR:-/tmp}/mesh-health.XXXXXX")
if mcurl -fsS "http://$HOST:$PORT/health" 2>"$health_err"; then
  printf '\n'
  rm -f "$health_err"
else
  cat "$health_err"
  rm -f "$health_err"
  exit 1
fi

printf 'agents: '
code=$(http_code "http://$HOST:$PORT/agents")
if [ "$code" = "200" ]; then
  printf 'active\n'
else
  printf 'HTTP %s\n' "$code"
  exit 1
fi

printf 'events: '
code=$(http_code "http://$HOST:$PORT/events")
if [ "$code" = "200" ]; then
  printf 'active\n'
else
  printf 'HTTP %s\n' "$code"
  exit 1
fi

printf 'tailnet: '
tailnet_body=$(mktemp "${TMPDIR:-/tmp}/mesh-tailnet.XXXXXX")
code=$(mcurl -s -o "$tailnet_body" -w '%{http_code}' "http://$HOST:$PORT/tailnet")
if [ "$code" = "200" ] && grep '"ok":true' "$tailnet_body" >/dev/null 2>&1; then
  printf 'active\n'
else
  printf 'HTTP %s ' "$code"
  head -c 180 "$tailnet_body"
  printf '\n'
  rm -f "$tailnet_body"
  exit 1
fi
rm -f "$tailnet_body"

printf 'bridge: '
code=$(curl -s -o /dev/null -w '%{http_code}' "http://$BRIDGE_HOST:$BRIDGE_PORT/")
case "$code" in
  2*|3*) printf 'active\n' ;;
  *)
    printf 'HTTP %s\n' "$code"
    exit 1
    ;;
esac

printf 'VNC: '
code=$(curl -s -o /dev/null -w '%{http_code}' "$VNC_URL")
case "$code" in
  2*|3*) printf 'active\n' ;;
  000) printf 'not configured (%s)\n' "$VNC_URL" ;;
  *) printf 'HTTP %s (%s)\n' "$code" "$VNC_URL" ;;
esac

printf 'hooks: '
if "${MESH_HOME:-$HOME/.mesh}/bin/mesh-event" self-check "Mesh self-check" "events OK" >/dev/null 2>&1; then
  printf 'active\n'
else
  printf 'failed\n'
  exit 1
fi
