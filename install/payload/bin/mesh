GLOBAL
  -H, --host <name>           target host (default: config default, else localhost)
  --json                      machine-readable output (for agents/scripts)
  -h, --help                  this help;  mesh help <command> for details
  version

Config: ${HOSTS_FILE}   ·   mesh man   for the full manual`;

const CMD_HELP: Record<string, string> = {
  new: `mesh new <name> [-H host] [--cmd C] [--cwd DIR] [--task "..."]

Start a new session. --cmd is any CLI (claude, codex, pi, bun, a shell one-liner);
omit it for a plain shell. --task types a natural-language prompt into the launched
program after it starts. --cwd sets the working directory.

  mesh new fix-bug --cmd claude --task "fix the failing watch test"
  mesh new build -H pi --cmd bun --cwd ~/proj`,
  send: `mesh send <session> <text...> [-H host]

Type text into a session and press Enter. Quote multi-word text.
  mesh send fix-bug "run the tests"`,
  key: `mesh key <session> <key> [-H host]

Send a single key. Supported: enter, ctrl-c, ctrl-d, up, down, left, right,
tab, escape, backspace, delete, home, end, page-up, page-down.
  mesh key fix-bug enter        # approve a prompt
  mesh key fix-bug ctrl-c       # interrupt`,
  "host": `mesh host add <name> <ip> [--port N] [--token T]   (default port 8899; token via 'mesh pair')
mesh host rm <name>
mesh host default <name>

Hosts are stored in ${HOSTS_FILE}. The first host added becomes the default.`,
  upgrade: `mesh upgrade [-H host] [--src URL|DIR|TGZ] [--no-restart] [--json]

Install the latest meshd + tools and restart the daemon.

Without -H it upgrades THIS machine: the new payload is staged inside ${MESH_HOME},
booted on a scratch port and made to report its own version before anything moves,
then swapped in by rename. The previous meshd is kept under ${MESH_HOME}/backups
and put back automatically if the restarted daemon does not come up as the new
version. Your token, hosts.json, push tokens, KB and event log are never touched.

--src accepts an https .tgz (verified against <url>.sha256 when the release has one),
a local .tgz, or a checkout directory — how you deploy an unreleased build. Default:
\$MESH_SRC, else the latest GitHub release.

With -H it starts the installer on that host in its own tmux session (so it survives
the daemon restart) and waits up to 3 minutes for the host to report a new version.
A local directory --src is refused there: the remote machine cannot see your disk.

  mesh upgrade                          # this machine, from the latest release
  mesh upgrade --src ~/Projects/lecoder-watch/install   # from a checkout
  mesh upgrade --no-restart             # install the files, restart later yourself
  mesh upgrade -H dataflow              # upgrade a remote host and watch it flip`,
  status: `mesh status [--json]

One line per machine — this one first, then every host in ${HOSTS_FILE}:
address, meshd version, uptime, and (when the daemon answers /doctor) how many
capability checks pass. Hosts are probed concurrently with a 5s timeout each, so one
dead machine costs the whole command 5 seconds, not 5 seconds per host.

  mesh status          # is the fleet healthy, and is anything left on an old build?`,
  token: `mesh token rotate [-H host] [--yes] [--json]

Replace this machine's meshd bearer token. Use it the moment a token is exposed — in a
log, a screenshot, a pasted config, or an AI session transcript.

Locally: mints 64 hex characters, keeps the old value as ${MESH_HOME}/token.bak-<UTC>,
rewrites the launchd plist / systemd unit (they embed the token, so a restart alone
would bring the daemon back on the OLD one), restarts meshd, and then proves the running
daemon serves the new token by pairing against itself over loopback.

The new token is NEVER printed — not even with --json. Read it from ${TOKEN_FILE}
if you must; better, run 'mesh pair' and let the phone take it.

Afterwards every phone, watch and peer holding the old token is locked out. Re-pair the
phone with 'mesh pair'; update each peer with
  mesh host add <name> <ip> --token <new>
run ON that peer, or re-pair it. There is no endpoint that pushes a token to peers and
there will not be one: that would be a fleet-wide remote-credential-write.

With -H it runs the rotation on that host in its own tmux session and waits for YOUR
stored token to start being rejected (401) — the only proof available from here. The new
token stays on that machine; nothing can read it remotely.

  mesh token rotate --yes            # this machine, no confirmation
  mesh token rotate -H dataflow      # rotate a peer, then re-pair it`,
  setup: `mesh setup

The first-run walk-through: confirms meshd is running (and prints the install command if
it is not), runs 'mesh doctor' and offers to pop the macOS permission dialogs, shows the
pairing QR with instructions for the Camera app, and ends on 'mesh status'.

Everything it does is available as a separate command; this is the order to do them in.
Without a TTY it prints that order as a checklist instead of prompting.`,
  shellenv: `mesh shellenv

Print one line that puts ${join(MESH_HOME, "bin")} on PATH. Add it to your shell rc:

  echo 'eval "$(~/.mesh/bin/mesh shellenv)"' >> ~/.zshrc   # or ~/.bashrc
  source ~/.zshrc

The installer does this for you; this command is the manual version and what the
installer's line calls.`,
  doctor: `mesh doctor [-H host] [--fix]

Tests what the daemon can actually do — token, input injection, screen capture,
multiplexer, push — by doing it, and prints the fix for anything broken.
--fix additionally makes macOS show the Accessibility and Screen Recording
permission dialogs on that machine (approve them at the machine, then re-run).

  mesh doctor                 # this machine
  mesh doctor -H studio --fix # pop the permission dialogs on studio`,
};

function help(topic?: string) {
  if (topic && CMD_HELP[topic]) console.log(CMD_HELP[topic]);
  else console.log(HELP);
}

// ---------- dispatch ----------

async function main() {
  const argv = process.argv.slice(2);
  const { pos, flags, bools } = parse(argv);
  const cmd = pos.shift();
  const cfg = loadConfig();

  if (!cmd || cmd === "help") return help(pos[0]);
  if (bools.has("help") || bools.has("h")) return help(cmd === "host" ? "host" : cmd);
  if (cmd === "version" || bools.has("version")) return console.log(VERSION);
  if (cmd === "man") {
    const p = join(MESH_HOME, "share/man/man1/mesh.1");
    if (!existsSync(p)) die(`man page not installed (expected ${p}); try: mesh help`);
    Bun.spawnSync(["man", p], { stdio: ["inherit", "inherit", "inherit"] });
    return;
  }

  switch (cmd) {
    case "setup": return cmdSetup(cfg);
    case "desktop": return cmdDesktop();
    case "shellenv": return cmdShellenv();
    case "pair": return cmdPair(flags, cfg);
    case "token": {
      const sub = pos.shift();
      if (sub === "rotate") return cmdTokenRotate(flags, bools, cfg);
      return die("usage: mesh token rotate [-H host] [--yes]   (mesh help token)");
    }
    case "hooks": return cmdHooks(pos, flags, cfg);
    case "hosts": return cmdHosts(cfg);
    case "host": {
      const sub = pos.shift();
      if (sub === "add") return cmdHostAdd(pos, flags, cfg);
      if (sub === "rm" || sub === "remove") return cmdHostRm(pos, cfg);
      if (sub === "default") return cmdHostDefault(pos, cfg);
      return die("usage: mesh host <add|rm|default> ...");
    }
    case "ls": case "agents": return cmdLs(flags, cfg);
    case "peek": case "output": case "logs": return cmdPeek(pos, flags, cfg);
    case "send": return cmdSend(pos, flags, cfg);
    case "key": return cmdKey(pos, flags, cfg);
    case "new": return cmdNew(pos, flags, cfg);
    case "kill": return cmdKill(pos, flags, cfg);
    case "usage": case "limits": return cmdUsage(flags, cfg);
    case "health": return cmdHealth(flags, cfg);
    case "status": return cmdStatus(cfg);
    case "upgrade": case "update": return cmdUpgrade(flags, bools, cfg);
    case "doctor": return cmdDoctor(flags, cfg, bools);
    case "events": return cmdEvents(flags, cfg);
    case "uninstall": return cmdUninstall(bools, cfg);
    default: die(`unknown command: ${cmd}  (try: mesh help)`);
  }
}

main().catch((e: any) => die(e?.message || String(e)));
