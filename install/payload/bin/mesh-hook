#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request


def load_stdin():
    if sys.stdin.isatty():
        return {}
    raw = sys.stdin.read().strip()
    if not raw:
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return {"body": raw}


def pick(doc, *keys):
    for key in keys:
        val = doc.get(key)
        if val:
            return str(val)
    return None


def event_title(source, doc, override=None):
    if override:
        return override
    source = source.lower()
    hook = pick(doc, "hook_event_name", "event", "type")
    tool = pick(doc, "tool_name", "tool")
    if source == "claude":
        if hook == "Notification":
            return "Claude needs attention"
        if hook == "Stop":
            return "Claude stopped"
        if hook == "SubagentStop":
            return "Claude subagent stopped"
        if hook == "PreToolUse" and tool:
            return f"Claude tool: {tool}"
        return pick(doc, "title") or "Claude event"
    if source == "codex":
        return pick(doc, "title") or (f"Codex: {hook}" if hook else "Codex event")
    if source == "pi":
        return pick(doc, "title") or (f"Pi: {hook}" if hook else "Pi event")
    return pick(doc, "title", "event", "hook_event_name", "tool_name") or "Agent event"


def _display(base, fmt):
    try:
        out = subprocess.run(base + [fmt], capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return None
    val = out.stdout.strip()
    return val if out.returncode == 0 and val else None


def mux_target():
    """(session, pane) of the multiplexer pane this hook runs inside, or (None, None).

    This is not cosmetic. The reply buttons on a notification post to
    /agents/<session>/send, so `session` has to be the name `mesh ls` shows -- the
    bare #S, which is also what the apps match against the agent list. Falling back
    to the working directory -- which is what happens without this -- produces an
    event you can see and cannot answer.

    The pane (#S:#I.#P) travels separately: send-keys to a bare session name lands
    in whichever pane is active, which is not necessarily the agent's. meshd's send
    route already accepts a pane target; carrying it lets a client answer the exact
    pane. Best-effort -- a mux that cannot format it still yields the session.
    """
    for var, cmd in (("TMUX", "tmux"), ("RMUX", "rmux")):
        if not os.getenv(var):
            continue
        # Without -t, the mux answers for its active client, which may be looking
        # at a different session than the one this hook is running in.
        pane_id = os.getenv(var + "_PANE")
        base = [cmd, "display-message", "-p"] + (["-t", pane_id] if pane_id else [])
        session = _display(base, "#S")
        if not session:
            continue
        return session, _display(base, "#S:#I.#P")
    return None, None


def event_level(source, doc):
    hook = pick(doc, "hook_event_name", "event", "type")
    haystack = " ".join(
        str(v).lower()
        for v in [
            source,
            hook,
            pick(doc, "title"),
            pick(doc, "body", "message", "prompt", "command"),
        ]
        if v
    )
    if any(word in haystack for word in ["error", "failed", "failure", "panic", "crash"]):
        return "error"
    if source.lower() == "claude" and hook == "Notification":
        return "warning"
    if any(word in haystack for word in ["needs input", "waiting", "approval", "attention", "thermal", "hot"]):
        return "warning"
    return "info"


def main():
    parser = argparse.ArgumentParser(description="Post an agent hook event to meshd.")
    parser.add_argument("--source", default=os.getenv("MESH_HOOK_SOURCE", "agent"))
    parser.add_argument("--title")
    parser.add_argument("--body")
    parser.add_argument("--session", default=os.getenv("MESHD_SESSION"))
    parser.add_argument("--level", default=os.getenv("MESHD_LEVEL"))
    parser.add_argument("--dry-run", action="store_true", help="Print the event JSON without posting.")
    args = parser.parse_args()

    doc = load_stdin()
    title = event_title(args.source, doc, args.title)
    # Not the transcript path: a file path is not a body. 212 of one day's 312 events
    # were "Claude event" banners whose whole text was a .cursor/ transcript location.
    body = args.body or pick(doc, "body", "message", "prompt", "command")
    # Multiplexer session first: it is the only name the reply path can address.
    # An explicit --session / MESHD_SESSION is the caller naming that target itself.
    session = args.session
    pane = None
    if not session:
        session, pane = mux_target()
    replyable = bool(session)
    if not session:
        # Bare terminal or IDE: nothing the reply route can address, and the event
        # says so instead of smuggling a cwd path into the session field. Keep the
        # folder name a human recognizes, not the full path.
        raw = pick(doc, "session", "cwd", "workspace")
        if raw:
            session = os.path.basename(raw.rstrip("/")) or raw
    # The identity the AGENT owns, which no multiplexer is involved in. Claude Code puts
    # `session_id` on every hook payload and Codex puts one on its own; we were throwing
    # it away and then trying to guess an identity from tmux, which is why a desktop-app
    # or worktree session was never matched to anything and the wrist reported that
    # nothing was waiting. `cwd` rides along purely as a label a human recognises — it is
    # not an identity, because two sessions can share one.
    session_id = pick(doc, "session_id", "sessionId")
    cwd = pick(doc, "cwd", "workspace")

    payload_doc = {
        "source": args.source,
        "title": title,
        "body": body,
        "session": session,
        "level": args.level or event_level(args.source, doc),
        "replyable": replyable,
    }
    if session_id:
        payload_doc["sessionId"] = session_id
    if cwd:
        payload_doc["cwd"] = cwd
    if pane:
        payload_doc["pane"] = pane
    if args.dry_run:
        print(json.dumps(payload_doc, indent=2, sort_keys=True))
        return 0

    token = os.getenv("MESHD_TOKEN")
    token_file = os.path.join(os.getenv("MESH_HOME", os.path.expanduser("~/.mesh")), "token")
    if not token and os.path.exists(token_file):
        with open(token_file, "r", encoding="utf-8") as f:
            token = f.readline().strip()
    if not token:
        print(f"mesh-hook: missing MESHD_TOKEN and unreadable {token_file}", file=sys.stderr)
        return 0

    host = os.getenv("MESHD_HOST", "127.0.0.1")
    port = os.getenv("MESHD_PORT", "8899")
    payload = json.dumps(payload_doc).encode()
    req = urllib.request.Request(
        f"http://{host}:{port}/events",
        data=payload,
        headers={"authorization": f"Bearer {token}", "content-type": "application/json"},
        method="POST",
    )
    try:
        urllib.request.urlopen(req, timeout=3).read()
        return 0
    except urllib.error.HTTPError as e:
        print(f"mesh-hook: HTTP {e.code}", file=sys.stderr)
    except OSError as e:
        print(f"mesh-hook: {e}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    # Never a non-zero exit, whatever happens inside.
    #
    # This hook is registered on Stop, and Claude Code treats a Stop hook exiting 2 as a
    # BLOCKING error: it refuses to end the turn and loops. So an unreadable token file —
    # a rotated token, a half-finished install, a MESH_HOME that moved — did not merely
    # lose a notification, it wedged the session that was trying to finish. Verified on
    # the deployed hook: `printf '{"hook_event_name":"Stop"}' | env -u MESHD_TOKEN
    # MESH_HOME=/nonexistent mesh-hook --source claude` exits 2.
    #
    # This is telemetry. It has no opinion about whether the agent may proceed, so it must
    # never be able to express one. Failures go to stderr, where Claude shows them without
    # acting on them, and the exit status stays 0 — including for an argparse error or an
    # unexpected exception, which would otherwise escape as 2 and 1 respectively.
    try:
        main()
    except SystemExit as e:                     # argparse --help / bad flags
        if e.code not in (0, None):
            print(f"mesh-hook: exiting 0 despite {e.code} — a hook must not block a turn",
                  file=sys.stderr)
    except Exception as e:                      # anything at all
        print(f"mesh-hook: {type(e).__name__}: {e}", file=sys.stderr)
    raise SystemExit(0)
